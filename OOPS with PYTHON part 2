class animal:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def eat(self):
        print(self.name, "eats")

    def speak(self):
        print(self.name, "speaks")


class Dog(animal):
    def __init__(self, name, age, breed):
        super().__init__(name, age)
        self.breed = breed

    def sound(self):
        print(self.name, "barks")


D1 = Dog("Tommy", 3, "Labrador")

print("Name:", D1.name)
print("Age:", D1.age)
print("Breed:", D1.breed)

D1.eat()
D1.speak()
D1.sound()

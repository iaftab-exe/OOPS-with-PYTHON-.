class Student:
    def __init__(self, marks):
        self.marks = marks

    def compare(self, other):
        if self.marks > other.marks:
            print("First student scored higher")
        elif self.marks < other.marks:
            print("Second student scored higher")
        else:
            print("Both scored equally")

s1 = Student(90)
s2 = Student(80)

s1.compare(s2)
